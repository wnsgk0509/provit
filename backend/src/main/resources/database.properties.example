# ==========================================
# Oracle 19c 데이터베이스 접속 정보 템플릿
# 팀원 가이드: 이 파일을 복사하여 같은 위치에 'database.properties' 파일을 만들고,
# 본인의 로컬 Oracle 계정 및 서비스명으로 수정하여 사용하세요.
# (주의: database.properties 파일은 .gitignore에 의해 Git에 올라가지 않습니다)
# ==========================================

# 드라이버 클래스명 (Oracle 19c)
db.driverClassName=oracle.jdbc.OracleDriver

# JDBC URL (Oracle 19c 기본 SID는 orcl 입니다)
# SID 방식: jdbc:oracle:thin:@localhost:1521:orcl
# 서비스명 방식: jdbc:oracle:thin:@localhost:1521/orcl 또는 orclpdb
db.url=jdbc:oracle:thin:@localhost:1521:orcl

# 사용자 계정 및 비밀번호
db.username=scott
db.password=tiger

# 커넥션 풀 설정
db.maxPoolSize=10
db.minIdle=2
