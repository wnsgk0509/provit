<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="recruitment_mapper">

    <!-- 대분류 직군 전체 목록 조회 (코드 번호순 정렬) -->
    <select id="selectOccupationList" resultType="com.provit.dto.recruitment.OccupationDTO">
        SELECT 
            OCCUPATION_CODE AS occupationCode,
            OCCUPATION_NAME AS occupationName
        FROM T_OCCUPATION
        ORDER BY TO_NUMBER(OCCUPATION_CODE)
    </select>

</mapper>